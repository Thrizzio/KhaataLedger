generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EMPLOYEE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model User {
  id           String   @id @default(uuid())

  name         String
  email        String   @unique
  passwordHash String

  role         Role

  // Employee credentials
  employeeId   String?  @unique

  // Businesses owned by this user
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")

  // Business where this user works
  workspaceId  String?
  workspace    Workspace? @relation("WorkspaceEmployees", fields: [workspaceId], references: [id])

  transactions Transaction[] @relation("CreatedTransactions")
  auditLogs    AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model Workspace {
  id        String @id @default(uuid())

  name      String

  // Boss
  ownerId   String
  owner     User @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  users User[] @relation("WorkspaceEmployees")

  transactions Transaction[]

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Transaction {
  id String @id @default(uuid())

  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title String

  description String?

  amount Decimal @db.Decimal(12,2)

  type TransactionType

  transactionDate DateTime

  createdById String
  createdBy User @relation("CreatedTransactions", fields: [createdById], references: [id])

  version Int @default(1)

  deletedAt DateTime?

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model AuditLog {
  id String @id @default(uuid())

  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  action AuditAction

  transactionId String?
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  userId String
  user User @relation(fields: [userId], references: [id])

  previousValue Json?

  newValue Json?

  createdAt DateTime @default(now())
}