generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  EMPLOYEE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum KhataEntryType {
  CREDIT
  PAYMENT
}


enum PaymentType {
  CASH
  CREDIT
}

model User {
  id           String   @id @default(uuid())

  name         String
  email        String   @unique
  passwordHash String

  role         Role

  sales Sale[] @relation("SaleCreator")
  purchases Purchase[] @relation("PurchaseCreator")
  // Employee credentials
  employeeId   String?  @unique

  // Businesses owned by this user
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")

  // Business where this user works
  workspaceId  String?
  workspace    Workspace? @relation("WorkspaceEmployees", fields: [workspaceId], references: [id])

  transactions Transaction[] @relation("CreatedTransactions")
  auditLogs    AuditLog[]

  createdKhatas       Khata[]       @relation("CreatedKhatas")
  createdKhataEntries KhataEntry[]  @relation("CreatedKhataEntries")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  failedLoginAttempts Int @default(0)
  lockedUntil         DateTime?

  @@index([workspaceId])
}

model Workspace {
  id        String @id @default(uuid())

  name      String

  // Boss
  ownerId   String
  owner     User @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  users User[] @relation("WorkspaceEmployees")

  transactions Transaction[] @relation("WorkspaceTransactions")
  auditLogs AuditLog[]
  khatas Khata[]

  
  sales Sale[] @relation("SaleWorkspace")
  purchases Purchase[] @relation("PurchaseWorkspace")
  inventoryItems InventoryItem[] @relation("InventoryItemWorkspace")
  customers Customer[] @relation("CustomerWorkspace")
  suppliers Supplier[] @relation("SupplierWorkspace")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Transaction {
  id String @id @default(uuid())

  workspaceId String
  workspace Workspace @relation("WorkspaceTransactions", fields: [workspaceId], references: [id], onDelete: Cascade)

  title String

  description String?

  amount Decimal @db.Decimal(12,2)

  type TransactionType

  transactionDate DateTime

  createdById String
  createdBy User @relation("CreatedTransactions", fields: [createdById], references: [id])

  version Int @default(1)

  deletedAt DateTime?

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model AuditLog {
  id String @id @default(uuid())

  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  action AuditAction

  transactionId String?
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  khataId String?
  khata Khata? @relation(fields: [khataId], references: [id])

  userId String
  user User @relation(fields: [userId], references: [id])

  previousValue Json?

  newValue Json?

  createdAt DateTime @default(now())

  @@index([khataId])
}

model Khata {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Legacy standalone fields kept for backward compatibility
  customerName   String
  contactNumber  String
  title          String
  initialAmount  Decimal   @db.Decimal(12,2)

  // Change #1: optional FK linking this Khata to a Customer record
  customerId     String?
  customer       Customer? @relation("KhataCustomer", fields: [customerId], references: [id])

  createdById    String
  createdBy      User      @relation("CreatedKhatas", fields: [createdById], references: [id])

  entries        KhataEntry[]
  auditLogs      AuditLog[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@unique([workspaceId, customerName])
  @@index([workspaceId])
  @@index([customerId])
  @@index([deletedAt])
}

model KhataEntry {
  id             String         @id @default(uuid())
  khataId        String
  khata          Khata          @relation(fields: [khataId], references: [id], onDelete: Cascade)

  title          String
  amount         Decimal        @db.Decimal(12,2)
  type           KhataEntryType
  entryDate      DateTime

  // Change #3: optional FK to the Sale that created this credit entry
  saleId         String?
  sale           Sale?          @relation("KhataEntrySale", fields: [saleId], references: [id])

  createdById    String
  createdBy      User           @relation("CreatedKhataEntries", fields: [createdById], references: [id])

  createdAt      DateTime       @default(now())
  deletedAt      DateTime?

  @@index([khataId])
  @@index([saleId])
  @@index([deletedAt])
}

model LoginAuditLog {
  id          String   @id @default(uuid())
  email       String?
  ipAddress   String?
  timestamp   DateTime @default(now())

  @@index([email])
}

// ==== NEW BUSINESS DOMAIN MODELS ====

model InventoryItem {
  id                  String   @id @default(uuid())
  workspaceId         String
  workspace           Workspace @relation("InventoryItemWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  name                String
  sku                 String?
  unit                String?
  currentStock        Int      @default(0)
  defaultSellingPrice Decimal  @db.Decimal(12,2)
  // Change #6: tracks latest purchase cost; null until first purchase is recorded
  lastPurchasePrice   Decimal? @db.Decimal(12,2)
  // Change #5: soft-delete support so historical line items remain intact
  deletedAt           DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  saleLineItems       SaleLineItem[]     @relation("SaleLineItemInventory")
  purchaseLineItems   PurchaseLineItem[] @relation("PurchaseLineItemInventory")

  @@index([workspaceId])
  @@index([workspaceId, sku])
  @@index([sku])
  @@index([deletedAt])
}

model Customer {
  id                 String   @id @default(uuid())
  workspaceId        String
  workspace          Workspace @relation("CustomerWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  phoneNumber        String?
  outstandingBalance Decimal  @db.Decimal(12,2) @default(0)

  sales              Sale[]       @relation("SaleCustomer")
  // Change #2: back-relation added once Khata gains customerId FK (Change #1)
  khatas             Khata[]      @relation("KhataCustomer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model Supplier {
  id            String   @id @default(uuid())
  workspaceId   String
  workspace     Workspace @relation("SupplierWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  purchases Purchase[] @relation("PurchaseSupplier")  
  phoneNumber   String?
  outstandingBalance Decimal @db.Decimal(12,2) @default(0) // Amount owed to supplier
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceId])
}

model Sale {
  id            String      @id @default(uuid())
  workspaceId   String
  workspace     Workspace   @relation("SaleWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?   @relation("SaleCustomer", fields: [customerId], references: [id])
  createdById   String
  createdBy     User        @relation("SaleCreator", fields: [createdById], references: [id])
  saleDate      DateTime
  totalAmount   Decimal     @db.Decimal(12,2)
  paymentType   PaymentType
  createdAt     DateTime    @default(now())

  lineItems     SaleLineItem[]  @relation("SaleLineItemSale")
  // Change #4: back-relation required because KhataEntry now has saleId FK
  khataEntries  KhataEntry[]    @relation("KhataEntrySale")

  @@index([workspaceId])
  @@index([customerId])
}

model SaleLineItem {
  id              String        @id @default(uuid())
  saleId          String
  sale            Sale          @relation("SaleLineItemSale", fields: [saleId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation("SaleLineItemInventory", fields: [inventoryItemId], references: [id])
  quantity        Int
  sellingPrice    Decimal       @db.Decimal(12,2)
  // Change #7: immutable snapshot of product name at time of sale
  productName     String        @default("")

  @@index([saleId])
  @@index([inventoryItemId])
}

model Purchase {
  id            String      @id @default(uuid())
  workspaceId   String
  workspace     Workspace   @relation("PurchaseWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  supplierId    String?
  supplier      Supplier?   @relation("PurchaseSupplier", fields: [supplierId], references: [id])
  createdById   String
  createdBy     User        @relation("PurchaseCreator", fields: [createdById], references: [id])
  purchaseDate  DateTime
  totalAmount   Decimal     @db.Decimal(12,2)
  // Change #9: purchase payment type; defaults to CASH so existing rows are unaffected
  paymentType   PaymentType @default(CASH)
  createdAt     DateTime    @default(now())

  lineItems     PurchaseLineItem[] @relation("PurchaseLineItemPurchase")

  @@index([workspaceId])
  @@index([supplierId])
}

model PurchaseLineItem {
  id              String        @id @default(uuid())
  purchaseId      String
  purchase        Purchase      @relation("PurchaseLineItemPurchase", fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation("PurchaseLineItemInventory", fields: [inventoryItemId], references: [id])
  quantity        Int
  purchasePrice   Decimal       @db.Decimal(12,2)
  // Change #8: immutable snapshot of product name at time of purchase
  productName     String        @default("")

  @@index([purchaseId])
  @@index([inventoryItemId])
}
