generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EMPLOYEE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum KhataEntryType {
  CREDIT
  PAYMENT
}

model User {
  id           String   @id @default(uuid())

  name         String
  email        String   @unique
  passwordHash String

  role         Role

  // Employee credentials
  employeeId   String?  @unique

  // Businesses owned by this user
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")

  // Business where this user works
  workspaceId  String?
  workspace    Workspace? @relation("WorkspaceEmployees", fields: [workspaceId], references: [id])

  transactions Transaction[] @relation("CreatedTransactions")
  auditLogs    AuditLog[]

  createdKhatas       Khata[]       @relation("CreatedKhatas")
  createdKhataEntries KhataEntry[]  @relation("CreatedKhataEntries")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model Workspace {
  id        String @id @default(uuid())

  name      String

  // Boss
  ownerId   String
  owner     User @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  users User[] @relation("WorkspaceEmployees")

  transactions Transaction[]

  auditLogs AuditLog[]

  khatas Khata[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Transaction {
  id String @id @default(uuid())

  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title String

  description String?

  amount Decimal @db.Decimal(12,2)

  type TransactionType

  transactionDate DateTime

  createdById String
  createdBy User @relation("CreatedTransactions", fields: [createdById], references: [id])

  version Int @default(1)

  deletedAt DateTime?

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model AuditLog {
  id String @id @default(uuid())

  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  action AuditAction

  transactionId String?
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  userId String
  user User @relation(fields: [userId], references: [id])

  previousValue Json?

  newValue Json?

  createdAt DateTime @default(now())
}

model Khata {
  id             String @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  customerName   String
  contactNumber  String
  title          String
  initialAmount  Decimal @db.Decimal(12,2)

  createdById    String
  createdBy      User @relation("CreatedKhatas", fields: [createdById], references: [id])

  entries        KhataEntry[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([workspaceId, customerName])
  @@index([workspaceId])
}

model KhataEntry {
  id             String @id @default(uuid())
  khataId        String
  khata          Khata @relation(fields: [khataId], references: [id], onDelete: Cascade)

  title          String
  amount         Decimal @db.Decimal(12,2)
  type           KhataEntryType
  entryDate      DateTime

  createdById    String
  createdBy      User @relation("CreatedKhataEntries", fields: [createdById], references: [id])

  createdAt      DateTime @default(now())

  @@index([khataId])
}